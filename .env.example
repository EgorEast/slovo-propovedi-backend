# Copy to .env for local development. Not read by anything else in this
# repo — production env is generated by .forgejo/workflows/release.yml from
# Forgejo org variables + secrets (see docs/architecture.md).
#
# Only the vars actually read by the code are listed (checked against
# process.env.*/ConfigService.get(...) usages, not copied from an older
# .env — that file had drifted: several MINIO_*/JWT_*_EXPIRY/ADMINER_PORT
# keys it carried are not read anywhere in this repo).

### Org-wide hostnames (bare hostnames — mirror the Forgejo org-level Actions
### variables of the same name). REQUIRED: src/main.ts throws on boot if
### LANDING_HOSTNAME/WEB_HOSTNAME are unset, and orval.config.mjs throws if
### DOCS_HOSTNAME is unset. In production these come from Forgejo org vars,
### not from this file.
DOCS_HOSTNAME=docs.slovo-propovedi.ru
LANDING_HOSTNAME=slovo-propovedi.ru
WEB_HOSTNAME=app.slovo-propovedi.ru

### Bare hostname of the deployed API — read by scripts/upload-sermons.mjs
### (the actual sermon upload goes through the API). Default here is the prod
### value; to test against a locally running backend, override to
### localhost:3000 or pass --api http://localhost:3000 (no prod fallback;
### on prod it is the Forgejo org var BACKEND_API_HOSTNAME).
BACKEND_API_HOSTNAME=api.slovo-propovedi.ru

# 'true' enables Swagger UI at /swagger-api, fetching the spec from
# OPENAPI_SPEC_URL (defaults to https://$DOCS_HOSTNAME/openAPI.yaml).
DOCS_ENABLED=false

### Auth — required, the app throws on boot if either is unset.
JWT_SECRET=dev-only-not-a-real-secret
JWT_REFRESH_SECRET=dev-only-not-a-real-secret-either

### Postgres / MinIO — required for the app to boot (TypeORM/MinIO clients
### connect eagerly), but NOT verified against a real local instance: local
### backend dev here doesn't run Postgres/MinIO (the playbook's pgbouncer/
### minio containers have no host-port exposure, Traefik-hostname only — see
### slovo-propovedi-playbook). Treat these as illustrative placeholders;
### fill in real values if/when you do run them locally. In production the
### release workflow fills these from Forgejo org vars (POSTGRES_HOST/PORT/
### USER/DB, MINIO_ENDPOINT, MINIO_MAIN_PORT_IN) and org secrets (passwords/keys).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=slovo
POSTGRES_USER=slovo
POSTGRES_PASSWORD=dev-only-not-a-real-secret

MINIO_ENDPOINT=localhost
MINIO_MAIN_PORT_IN=8050
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=dev-only-not-a-real-secret
MINIO_PUBLIC_URI=http://localhost:8050

### Deploy-time variables used by .forgejo/workflows/release.yml and
### scripts/vps-deploy.sh ( Forgejo org vars on prod; listed here for reference):
###   POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER, POSTGRES_DB,
###   MINIO_ENDPOINT, MINIO_MAIN_PORT_IN
### Secrets (org-level): BACKEND_MINIO_SECRET_KEY, MINIO_ACCESS_KEY,
###   BACKEND_POSTGRES_PASSWORD, BACKEND_JWT_SECRET, BACKEND_JWT_REFRESH_SECRET,
###   VPS_HOST, VPS_SSH_USER, VPS_SSH_PRIVATE_KEY
### vps-deploy.sh also requires (passed by the workflow): INTERNAL_PORT,
###   TRAEFIK_NETWORK, POSTGRES_NETWORK, MINIO_NETWORK, TRAEFIK_SERVICE
