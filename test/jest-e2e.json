{
  "moduleFileExtensions": ["js", "json", "ts", "mjs", "cjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.([mc]?[jt]s|tsx)$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2021",
          "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          }
        },
        "module": {
          "type": "commonjs"
        }
      }
    ]
  },
  "transformIgnorePatterns": []
}
